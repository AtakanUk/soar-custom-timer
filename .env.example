# Shared settings
TIMER_DB_PATH=data/custom_timer.db
TIMER_MAX_WAIT_SECONDS=3024000

# Worker settings
TIMER_POLL_SECONDS=15
TIMER_BATCH_SIZE=100
TIMER_LOG_FILE=logs/timer_worker.log
TIMER_FIELD=custom_timer_done

# IBM SOAR connection
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Org
SOAR_API_KEY_ID=your-api-key-id
SOAR_API_KEY_SECRET=your-api-key-secret
SOAR_VERIFY_TLS=true

# Optional alert email settings (Microsoft 365 SMTP OAuth)
ALERT_EMAIL_TO=soc-engineering@example.com
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=soar-notify@example.com
SMTP_FROM=soar-notify@example.com
SMTP_TENANT_ID=your-tenant-id
SMTP_CLIENT_ID=your-client-id
SMTP_CLIENT_SECRET=your-client-secret
SMTP_REFRESH_TOKEN=your-refresh-token
SMTP_VERIFY_TLS=true
